<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FoodPos.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="GreetingText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Shop settings" Opacity="0.7" />
            </StackPanel>
            <Button
                Content="Sign out"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="SignOut_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="560" Spacing="16">
                <TextBox x:Name="ShopNameBox" Header="Shop name" />
                <TextBox x:Name="CurrencyBox" Header="Currency code" PlaceholderText="PKR" />
                <TextBox
                    x:Name="FooterBox"
                    Header="Receipt footer"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="100" />

                <TextBlock x:Name="StatusText" Opacity="0.7" />

                <Button
                    x:Name="SaveButton"
                    Content="Save settings"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveButton_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
